# ==========================================
# ARGUS - Root .gitignore
# ==========================================

# ---------- Java / Maven ----------
**/target/
**/out/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/dependency-reduced-pom.xml

# Maven wrapper: keep the wrapper scripts and configuration
# !.mvn/wrapper/maven-wrapper.jar

# ---------- IDEs ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
*.swp
*.swo
*~

# ---------- Operating systems ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Environment variables / secrets ----------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
**/secrets/

# ---------- Logs ----------
*.log
logs/
**/logs/

# ---------- Tests / coverage / mutation testing ----------
**/coverage/
**/test-results/
**/surefire-reports/
**/failsafe-reports/
**/jacoco.exec
**/jacoco*.xml
**/pit-reports/
**/allure-results/
**/allure-report/

# ---------- Generated reports ----------
**/reports/generated/
**/generated-reports/
*.tmp
*.bak
*.orig

# ---------- Local databases / runtime data ----------
*.db
*.sqlite
*.sqlite3
*.h2.db
data/
runtime/
tmp/
temp/

# ---------- Python tools / scripts, if used ----------
__pycache__/
*.py[cod]
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node.js tools / frontend, if added ----------
node_modules/
dist/
build/
.next/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Docker / local overrides ----------
.env.docker
docker-compose.override.yml

# ---------- Local configuration ----------
application-local.yml
application-local.yaml
application-local.properties
application-dev-local.yml
application-dev-local.yaml
application-dev-local.properties

# ---------- OS / editor temporary files ----------
*.orig.*
*.rej
*.stackdump

# ---------- Keep useful project files ----------
!.gitignore
!.gitattributes
!.mvn/wrapper/maven-wrapper.properties
